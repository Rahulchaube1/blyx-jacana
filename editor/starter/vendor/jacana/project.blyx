use std::cli;
use console;
use jacana;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Compare a crude event rate with a directly standardized rate.");
        println!("Usage: jacana events trials weights");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = jacana_standardize([0, 6], [2, 6], [1, 1]);
    } else {
        if count != 3 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let events = console_vector(args_at(argv, 0));
        let trials = console_vector(args_at(argv, 1));
        let weights = console_vector(args_at(argv, 2));
        result = jacana_standardize(events, trials, weights);
    }
    if len(result) == 0 { stderr_line("Invalid input for Jacana. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
