use std::cli;
use jacana;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(jacana_standardize([0, 6], [2, 6], [1, 1]), [0.75, 0.5, -0.25, 8]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(jacana_standardize([1, 1], [2, 2], [2, 1]), [0.5, 0.5, 0, 4]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(jacana_standardize([1], [0], [1]), []) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(jacana_standardize([infinity], [2, 6], [1, 1]), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(jacana_standardize([0, 6], [infinity], [1, 1]), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(jacana_standardize([0, 6], [2, 6], [infinity]), []) { stderr_line("case 6 failed"); process_exit(1); }
    println!("passed");
}
